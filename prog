🧩 想定入力欄（追加）
•	TextBoxAddPoints（加算するポイント）
________________________________________
✅ 改修後コード（ポイント加算）
protected void ButtonSave_Click(object sender, EventArgs e)
{
    int userId = int.Parse(TextBoxID.Text);
    int addPoints;
    if (!int.TryParse(TextBoxAddPoints.Text, out addPoints))
    {
        LabelMsg.Text = "加算ポイントを整数で入力してください。";
        return;
    }

    string connStr = ConfigurationManager.ConnectionStrings["MyDb"].ConnectionString;
    using (SqlConnection conn = new SqlConnection(connStr))
    {
        string sql = "UPDATE Users SET points = points + @addPoints WHERE id = @id;";
        SqlCommand cmd = new SqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@addPoints", addPoints);
        cmd.Parameters.AddWithValue("@id", userId);

        conn.Open();
        int rows = cmd.ExecuteNonQuery();
        conn.Close();

        LabelMsg.Text = rows > 0 ? "ポイントを更新しました。" : "該当ユーザーが見つかりません。";
    }
}

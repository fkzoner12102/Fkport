protected void ButtonSave_Click(object sender, EventArgs e)
{
    int userId = int.Parse(TextBoxID.Text);
    string newName = TextBoxName.Text;
    string newEmail = TextBoxEmail.Text;

    if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newEmail))
    {
        LabelMsg.Text = "名前とメールを入力してください。";
        return;
    }

    string connStr = ConfigurationManager.ConnectionStrings["MyDb"].ConnectionString;
    using (SqlConnection conn = new SqlConnection(connStr))
    {
        string sql = "UPDATE Users SET name = @name, email = @email WHERE id = @id;";
        SqlCommand cmd = new SqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@name", newName);
        cmd.Parameters.AddWithValue("@email", newEmail);
        cmd.Parameters.AddWithValue("@id", userId);

        conn.Open();
        int rows = cmd.ExecuteNonQuery();
        conn.Close();

        LabelMsg.Text = rows > 0 ? "更新が完了しました。" : "該当ユーザーが見つかりません。";
    }
}
